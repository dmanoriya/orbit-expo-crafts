{
  "name": "headless-commerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable High-Performance Headless WooCommerce Commerce Platform powered by Turborepo",
  "packageManager": "pnpm@9.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:storefront": "turbo run dev --filter=storefront",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "woocommerce",
    "headless",
    "nextjs",
    "react",
    "turborepo",
    "wordpress"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT"
}
